# Local override file.
#
# Copy values here only if you want to opt into external services. The backend
# runs fully with its built-in defaults when this file is empty.
#
# Examples:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres

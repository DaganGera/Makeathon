# Zenithal backend — copy to `.env` and fill in to enable cloud Postgres (Supabase).
# WITHOUT this file the backend uses local SQLite automatically (nothing breaks).
#
# Use the Supabase "Session pooler" connection string (Project → Settings →
# Database → Connection string → "Session pooler", port 5432). It is IPv4-safe.
# Swap the driver prefix to the async one: postgresql+asyncpg://
#
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# If Supabase is ever unreachable at startup the backend logs a warning and
# transparently falls back to SQLite — the demo can never be blocked.
